generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String        @map("display_name")
  avatarUrl    String?       @map("avatar_url")
  bio          String?
  focusStreak  Int           @default(0) @map("focus_streak")
  lastActiveAt DateTime?     @map("last_active_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  hostedSessions  Session[]      @relation("HostedSessions")
  participations  Participant[]
  checkIns        CheckIn[]
  chatMessages    ChatMessage[]

  @@map("users")
}

model Session {
  id                   String            @id @default(uuid())
  title                String
  description          String?
  hostId               String            @map("host_id")
  status               SessionStatus     @default(waiting)
  visibility           SessionVisibility @default(public)
  scheduledStart       DateTime?         @map("scheduled_start")
  startedAt            DateTime?         @map("started_at")
  endedAt              DateTime?         @map("ended_at")
  focusDurationMinutes Int               @map("focus_duration_minutes")
  breakDurationMinutes Int               @map("break_duration_minutes")
  maxParticipants      Int               @default(10) @map("max_participants")
  tags                 String[]          @default([])
  currentRound         Int               @default(0) @map("current_round")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  host         User          @relation("HostedSessions", fields: [hostId], references: [id])
  participants Participant[]
  focusBlocks  FocusBlock[]
  chatMessages ChatMessage[]
  checkIns     CheckIn[]

  @@index([status])
  @@index([hostId])
  @@map("sessions")
}

model Participant {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  sessionId         String            @map("session_id")
  status            ParticipantStatus @default(joined)
  currentTask       String?           @map("current_task")
  joinedAt          DateTime          @default(now()) @map("joined_at")
  leftAt            DateTime?         @map("left_at")
  totalFocusMinutes Int               @default(0) @map("total_focus_minutes")

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@map("participants")
}

model FocusBlock {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  round     Int
  type      BlockType
  startedAt DateTime @default(now()) @map("started_at")
  endsAt    DateTime @map("ends_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("focus_blocks")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  userId    String?     @map("user_id")
  userName  String      @map("user_name")
  content   String
  type      MessageType @default(text)
  createdAt DateTime    @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("chat_messages")
}

model CheckIn {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  sessionId String      @map("session_id")
  mood      Int
  energy    EnergyLevel
  intention String
  createdAt DateTime    @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("check_ins")
}

enum SessionStatus {
  waiting
  active
  paused
  completed
}

enum SessionVisibility {
  public
  private
  friends
}

enum ParticipantStatus {
  joined
  focusing
  break_time @map("break")
  left
}

enum BlockType {
  focus
  break_time @map("break")
}

enum MessageType {
  text
  system
  encouragement
}

enum EnergyLevel {
  low
  medium
  high
}
