generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String    @id @default(cuid())
  email            String?
  emailVerifiedAt  DateTime? @map("email_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  presenceStyle    String    @default("quiet")
  transcriptOptIn  Boolean   @default(false) @map("transcript_opt_in")
  tier             String    @default("free")
  subscriptionId   String?   @map("subscription_id")
  dailyMinutesUsed Int       @default(0) @map("daily_minutes_used")
  minutesResetAt   DateTime  @default(now()) @map("minutes_reset_at")

  calls Call[]

  @@index([email])
  @@map("sessions")
}

model Call {
  id              String    @id @default(cuid())
  sessionId       String    @map("session_id")
  session         Session   @relation(fields: [sessionId], references: [id])
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  presenceStyle   String    @default("quiet")
  agentTurns      Int       @default(0) @map("agent_turns")
  userTurns       Int       @default(0) @map("user_turns")
  wsTicket        String    @unique @map("ws_ticket")

  @@index([sessionId])
  @@map("calls")
}
