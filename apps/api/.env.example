# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/still_here?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AI Services ─────────────────────────────────────────────
# The agent uses: STT (speech-to-text), LLM (chat), TTS (text-to-speech).
# Set at least one API key per category. The cheapest available is used automatically.

# OpenAI — covers all three: Whisper (STT), GPT-4o-mini (LLM), TTS-1 (TTS)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini    # optional, cheapest by default
OPENAI_TTS_VOICE=nova             # optional: alloy, echo, fable, onyx, nova, shimmer

# Deepgram — cheapest STT ($0.0043/min) and has TTS (Aura)
DEEPGRAM_API_KEY=

# ElevenLabs — highest quality TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # optional, defaults to "Adam" (pNInz6obpgDQGcFmaJgB)
ELEVENLABS_MODEL_ID=              # optional, defaults to eleven_turbo_v2_5 (free tier)
